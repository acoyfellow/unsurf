{
	"name": "@acoyfellow/proof-spec",
	"version": "0.0.1",
	"description": "Shared types for proof-spec.v0: observe/act/assert primitives + deterministic risk labeler.",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "src", "README.md", "LICENSE"],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"keywords": ["proof-spec", "agents", "eval", "observe-act-assert", "gateproof", "unsurf"],
	"author": "Jordan Coeyman <jcoeyman@cloudflare.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/acoyfellow/proof-spec"
	},
	"devDependencies": {
		"typescript": "^5.6.0"
	}
}
