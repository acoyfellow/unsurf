{
	"name": "unsurf",
	"version": "0.4.0",
	"description": "Authenticated browser runtime, proof artifacts, and reusable website seams",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./local-mcp": {
			"import": "./dist/local-mcp.js",
			"types": "./dist/local-mcp.d.ts"
		},
		"./skills/record": {
			"import": "./dist/skills/record.js",
			"types": "./dist/skills/record.d.ts"
		},
		"./skills/observe-video": {
			"import": "./dist/skills/observe-video.js",
			"types": "./dist/skills/observe-video.d.ts"
		},
		"./skills/loop": {
			"import": "./dist/skills/loop.js",
			"types": "./dist/skills/loop.d.ts"
		},
		"./investigate": {
			"import": "./dist/investigate.js",
			"types": "./dist/investigate.d.ts"
		}
	},
	"bin": {
		"unsurf": "./dist/cli.js",
		"unsurf-local-mcp": "./dist/local-mcp.js",
		"unsurf-daemon": "./examples/webmcp-daemon/daemon.ts"
	},
	"files": [
		"dist",
		"src",
		"examples/webmcp-daemon/daemon.ts",
		"examples/webmcp-daemon/README.md",
		"examples/webmcp-daemon/example-catalog.json",
		"!src/cf-worker.ts"
	],
	"keywords": [
		"api",
		"openapi",
		"web-scraping",
		"browser-automation",
		"schema-inference",
		"effect",
		"cloudflare-workers",
		"mcp"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/acoyfellow/unsurf"
	},
	"homepage": "https://unsurf.coey.dev",
	"scripts": {
		"dev": "bunx alchemy dev",
		"deploy": "bunx alchemy deploy",
		"build": "tsup",
		"prepublishOnly": "bun run check && bun run typecheck && bun run test && bun run build",
		"generate": "bunx drizzle-kit generate",
		"studio": "bunx drizzle-kit studio",
		"check": "bunx biome check .",
		"check:fix": "bunx biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun vitest run",
		"test:watch": "bun vitest",
		"lint": "bun run check && bun run typecheck"
	},
	"dependencies": {
		"@acoyfellow/proof-spec": "file:./vendor/proof-spec",
		"@cloudflare/ai": "^1.2.2",
		"@cloudflare/puppeteer": "^1.1.0",
		"@effect/platform": "^0.94.5",
		"@effect/schema": "^0.75.5",
		"@modelcontextprotocol/sdk": "^1.26.0",
		"drizzle-orm": "^0.45.1",
		"effect": "^3.19.17"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.2",
		"@cloudflare/workers-types": "^4.20260217.0",
		"@effect/vitest": "^0.27.0",
		"@types/node": "^25.2.3",
		"alchemy": "^0.84.0",
		"drizzle-kit": "^0.31.9",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"license": "MIT"
}
